# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
env/
.venv/
.env/

# Environment variables (contains API keys!)
.env

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*~

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg

# pytest / testing
.pytest_cache/
.coverage
htmlcov/

# mypy
.mypy_cache/

# Downloaded media files
*.mp4
*.webm
*.mkv
*.avi
*.mov
*.mp3
*.wav
*.jpg
*.jpeg
*.png
*.gif
*.webp

# Frontend static assets (favicons, PWA icons, logo) must ship to Vercel —
# re-include them despite the blanket image ignores above.
!frontend/public/**/*.png
!frontend/public/**/*.svg
!frontend/public/**/*.ico

# Temp / working directories
downloads/
output/
temp/
tmp/

# OS files
Thumbs.db
.DS_Store

# Logs
*.log

# Node / frontend dependencies
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

