# Chef's Loop Environment Variables
# Copy this to .env and fill in your values

# =============================================================================
# API Configuration
# =============================================================================
DEBUG=false

# Comma-separated allowed browser origins. In production set this to your
# Vercel domain, e.g. https://makerai.vercel.app
CORS_ORIGINS=http://localhost:5173

# =============================================================================
# Redis (Upstash for production)
# =============================================================================
REDIS_URL=redis://localhost:6379
# For Upstash: REDIS_URL=rediss://default:YOUR_PASSWORD@YOUR_ENDPOINT.upstash.io:6379

# =============================================================================
# Object storage (S3-compatible — Cloudflare R2 in production)
# =============================================================================
S3_ACCESS_KEY_ID=your_access_key
S3_SECRET_ACCESS_KEY=your_secret_key
S3_BUCKET_NAME=chefs-loop-clips
# R2 requires "auto"; for real AWS S3 use a region like us-east-1
S3_REGION=auto
# R2 endpoint. Leave blank to use real AWS S3 instead.
#   https://<account_id>.r2.cloudflarestorage.com
S3_ENDPOINT_URL=
# Public domain clips are served from (custom domain in front of the R2 bucket;
# r2.dev is rate-limited and not for production). Leave blank for AWS S3.
#   https://clips.yourdomain.com
S3_PUBLIC_BASE_URL=

# =============================================================================
# Rate Limiting
# =============================================================================
RATE_LIMIT_PER_HOUR=20
CACHE_REFRESH_THRESHOLD=5

# =============================================================================
# AI Providers
# =============================================================================
OPENROUTER_API_KEY=your_openrouter_key
OPENAI_API_KEY=your_openai_key

# =============================================================================
# Video Processing
# =============================================================================
FFMPEG_PATH=ffmpeg
CLIP_FORMAT=webm
CLIP_BITRATE=500k

# =============================================================================
# Residential download worker (downloader_worker.py)
# =============================================================================
# YouTube bot-blocks the cloud backend's datacenter IP, so downloads are done by
# a worker running on a residential connection (laptop / Raspberry Pi). It reads
# these vars plus the S3_* block and YOUTUBE_COOKIES above.
#
# Shared secret authenticating the worker's /internal/* calls. Set the SAME
# value on the Railway backend and on the worker machine's .env.
DOWNLOADER_SECRET=
# How long (seconds) the backend waits for the worker to deliver a raw video
# before failing the job with "Downloader offline". Backend-side only.
DOWNLOAD_WAIT_TIMEOUT=300
#
# --- Worker machine ONLY (leave blank on the backend) ---
# Base URL of the deployed backend the worker polls. The PUBLIC Railway host
# (not the *.railway.internal one), with no trailing /api.
#   https://cookingtool-production.up.railway.app
CLOUD_API_URL=
# Netscape-format cookie file contents, used by yt-dlp to authenticate to
# YouTube. Paste the whole file as a single value.
YOUTUBE_COOKIES=

